{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer SECRET_TOKEN"
      },
      "enabled": true
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "bun": {
      "type": "local",
      "command": ["bunx", "-y", "mcp-bun@latest"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["bunx", "-y", "@playwright/mcp", "--browser", "chromium"],
      "enabled": true
    }
  },
  "plugin": ["@slkiser/opencode-quota"],
  "provider": {
    "openai": {}
  }
}
